# SkillConnect Frontend Environment Variables

# Production Backend API URL (Points to your deployed Render service)
# Example: https://skillconnect-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket Server URL (Points to your deployed Render root URL)
# Example: https://skillconnect-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000

